# Copy to .env (git-ignored). Dev defaults below are NOT secrets; LLM keys are intentionally empty.

# --- infrastructure ---
DATABASE_URL=postgresql://alerting:alerting@localhost:5432/alerting
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=alerts@gs-alerting.local
MOCKGW_URL=http://localhost:8090
PUBLIC_BASE_URL=http://localhost:8080

# --- secrets ---
JWT_SECRET=compose-demo-jwt-secret-not-for-production
APP_SECRET=ZGV2LWFwcC1zZWNyZXQtMzItYnl0ZXMtbG9uZy1rZXkh
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# --- sign-in (docs/SSO.md): oidc = "Sign in with Vistula ID" (the local demo SSO on :8180) + username/password
# form; password = form only; demo = no login, "Viewing as" picker. Every demo account's password is DEMO_PASSWORD
# (default `demo`). The secrets above are public demo values: set your own on any shared server. ---
AUTH_MODE=oidc
# DEMO_PASSWORD=demo
# OIDC_ISSUER=http://localhost:8180
# OIDC_CLIENT_ID=herald
# OIDC_CLIENT_SECRET=herald-demo-client-secret-not-for-prod
# GITHUB_TOKEN=            # optional: or connect GitHub in Settings → Integrations
# TRUST_FORWARDED_FOR=true   # behind a reverse proxy
# Shared secret for POST /v1/inbound/sms (header X-Inbound-Secret). Empty = open (local dev). Set the same value
# on the backend and on mockgw.
INBOUND_SMS_SECRET=

# --- LLM (LiteLLM). Fill at least one provider key to enable AI features ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_FALLBACKS=
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# --- runtime ---
APP_ROLE=api
PORT=8080
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SKIP_MIGRATIONS=false
DEMO_FAST_ESCALATION=false

# --- test isolation (set by tests/conftest.py; leave empty otherwise) ---
MQ_PREFIX=
REDIS_PREFIX=

# --- docker build ---
PRELOAD_EMBEDDINGS=1
